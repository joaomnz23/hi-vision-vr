<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!--
        Largura e margem inicial (marginStart) da PreviewView NAO sao mais definidas aqui.
        Elas sao calculadas em runtime em MainActivity a partir do tamanho fisico real da
        lente (6.7cm) usando o DPI do aparelho, e ajustadas por calibracao manual salva em
        SharedPreferences. O 0dp/0dp abaixo eh so um placeholder ate o codigo rodar.
    -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:implementationMode="performance"
        app:scaleType="fillCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Segue exatamente os mesmos limites da PreviewView, sempre -->
    <com.example.hivisionvr.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintBottom_toBottomOf="@id/previewView" />

    <!-- Feedback textual do fluxo gesto -> escuta -> comando -> bluetooth -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:background="#99000000"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:text="Aguardando gesto de joinha..."
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView" />

</androidx.constraintlayout.widget.ConstraintLayout>
