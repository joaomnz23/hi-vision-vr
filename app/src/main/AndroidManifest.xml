<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissão obrigatória para acessar a câmera -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Permissão para captar o comando de voz -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Bluetooth Clássico (SPP) para falar com o ESP32 -->
    <!-- Android 11 (API 30) ou anterior: permissões "normais", concedidas na instalação -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Android 12+ (API 31+): permissão "perigosa", precisa ser solicitada em runtime -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- O SpeechRecognizer padrão do Android usa o serviço de reconhecimento online do Google -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Declara que o app precisa de câmera (qualquer uma) para funcionar -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="true" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.HiVisionVR"
        android:hardwareAccelerated="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|screenLayout"
            android:theme="@style/Theme.HiVisionVR.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
